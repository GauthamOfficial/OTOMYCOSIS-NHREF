# NHREF OtoScan settings.
#
# Do not edit this file directly. Run `python scripts/manage.py setup`, which
# creates the database and writes a real .env with generated secrets.
# The real .env is git ignored and must never be committed or shared.

# PostgreSQL connection for the service's own limited database user.
DATABASE_URL=postgresql+psycopg://ear_app:CHANGE_ME@localhost:5432/ear_screening

# Signs every login token. At least 32 random characters.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Where patient images are stored. Empty means the storage/ folder in the
# project. Point it at a backed up, access controlled drive in production.
STORAGE_DIR=

# Largest size, in KB, of a stored patient image. Larger uploads are
# compressed to fit before analysis.
# STORED_IMAGE_MAX_KB=200

# Sign in with Google. Paste the OAuth client ID from the Google Cloud
# Console (Google Auth Platform, Clients). There is no client secret for this
# kind of sign in. While this is empty, everyone signs in with a password;
# once it is set, only administrators can, as the emergency way in.
GOOGLE_CLIENT_ID=

# Set to true once the service is reached over HTTPS.
COOKIE_SECURE=false

# Set to true only behind a reverse proxy that sets X-Real-IP. Otherwise
# clients could put any address in the audit log.
TRUST_PROXY=false

# Reviewed cases required before a retraining run may start.
MIN_REVIEWS_FOR_RETRAIN=50

# Daily backtest: re-runs the model in service on every surgeon reviewed case
# from this hour each day (this computer's clock) and raises an alert on the
# Dashboard if performance falls. See docs/SETUP_GUIDE.md, section 11.
BACKTEST_ENABLED=true
BACKTEST_HOUR=2
# BACKTEST_WINDOW_DAYS=30
# BACKTEST_MIN_SENSITIVITY=0.90
# BACKTEST_MIN_CASES=30
# BACKTEST_MAX_AGREEMENT_DROP=0.10

# Optional: session lengths.
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_HOURS=10
